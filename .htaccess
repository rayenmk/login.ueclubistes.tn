# UE Clubiste — cache control
# Prevents browsers/proxies from serving a stale HTML page (which would keep
# pointing at old cached JS/CSS even after files change on the server).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
